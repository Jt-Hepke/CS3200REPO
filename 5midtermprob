flatten recursively

let rec flatten lists =              (* Define a recursive function *)
  match lists with                   (* Check the list *)
  | [] -> []                         (* Empty list gives empty list *)
  | first :: rest -> first @ flatten rest  (* Join first list with the rest *)


isort recursively

let rec insert x numbers =           (* Insert x into a sorted list *)
  match numbers with                 (* Check the list *)
  | [] -> [x]                        (* Empty list: x is the only item *)
  | first :: rest ->                 (* Separate first and rest *)
      if x <= first then             (* Does x belong before first? *)
        x :: numbers                 (* Put x at the beginning *)
      else                           (* Otherwise *)
        first :: insert x rest       (* Keep first and insert into rest *)

let rec isort numbers =              (* Define insertion sort *)
  match numbers with                 (* Check the list *)
  | [] -> []                         (* Empty list is already sorted *)
  | first :: rest ->                 (* Take the first number *)
      insert first (isort rest)      (* Sort rest, then insert first *)


