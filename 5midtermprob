define tree
type 'a tree =                 (* Define a tree holding values of type 'a *)
  | Empty                      (* An empty tree *)
  | Node of 'a tree * 'a * 'a tree (* Left subtree, value, right subtree *)

Implement elem
let rec elem x tree =                    (* Check whether x is in the tree *)
  match tree with                        (* Check the tree *)
  | Empty -> false                       (* An empty tree has no values *)
  | Node (left, value, right) ->         (* Get both subtrees and the value *)
      if x = value then true             (* Found x *)
      else if x < value then elem x left (* Smaller: search left *)
      else elem x right                  (* Larger: search right *)

Implement Insert 
let rec insert x tree =                      (* Insert x into the tree *)
  match tree with                            (* Check the tree *)
  | Empty -> Node (Empty, x, Empty)          (* Create a new node *)
  | Node (left, value, right) ->             (* Read the current node *)
      if x < value then                      (* x belongs on the left *)
        Node (insert x left, value, right)   (* Insert into left subtree *)
      else if x > value then                 (* x belongs on the right *)
        Node (left, value, insert x right)   (* Insert into right subtree *)
      else tree                              (* Duplicate: do not insert *)

Invariant checker
let is_bst tree =                                      (* Check the BST invariant *)
  let rec check lower upper tree =                     (* Check a subtree within bounds *)
    match tree with                                    (* Check the current tree *)
    | Empty -> true                                    (* Empty trees are valid *)
    | Node (left, value, right) ->                     (* Read the node *)
        let above_lower =                              (* Check lower bound *)
          match lower with                             (* Is there a lower bound? *)
          | None -> true                               (* No lower bound *)
          | Some low -> value > low                    (* Must be strictly greater *)
        in
        let below_upper =                              (* Check upper bound *)
          match upper with                             (* Is there an upper bound? *)
          | None -> true                               (* No upper bound *)
          | Some high -> value < high                  (* Must be strictly smaller *)
        in
        above_lower && below_upper                     (* Both bounds must hold *)
        && check lower (Some value) left               (* Check left subtree *)
        && check (Some value) upper right              (* Check right subtree *)
  in
  check None None tree                                 (* Start with no bounds *)


