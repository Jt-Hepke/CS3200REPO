type nat =
  | O
  | S of nat

Implement plus
let rec plus a b =                 (* Add two Peano numbers *)
  match a with                     (* Check the first number *)
  | O -> b                         (* Zero plus b equals b *)
  | S rest -> S (plus rest b)      (* Add one successor *)

Implement mult
let rec mult a b =                  (* Multiply two Peano numbers *)
  match a with                      (* Check the first number *)
  | O -> O                          (* Zero times b is zero *)
  | S rest -> plus b (mult rest b)  (* Add b one more time *)

