  implement first_of
  let rec first_of rules input =             (* Try rules in order *)
  match rules with                         (* Check the list of rules *)
  | [] -> None                             (* No rules left: no result *)
  | rule :: rest ->                        (* Get the first rule *)
      match rule input with                (* Apply the rule to the input *)
      | Some result -> Some result         (* Success: return the result *)
      | None -> first_of rest input        (* Failure: try the next rule *)


Ounit tests
open OUnit2                                           (* Import OUnit *)

let positive x =                                     (* Define the first rule *)
  if x > 0 then Some "positive" else None            (* Check if positive *)

let even x =                                         (* Define the second rule *)
  if x mod 2 = 0 then Some "even" else None          (* Check if even *)

let tests =                                          (* Create the test suite *)
  "first_of tests" >::: [                            (* Name the suite *)
    "empty rules" >:: (fun _ ->                      (* Test empty input *)
      assert_equal None (first_of [] 5));            (* No rules means None *)

    "first rule succeeds" >:: (fun _ ->              (* Test first success *)
      assert_equal (Some "positive")                 (* Expected result *)
        (first_of [positive; even] 4));               (* Actual result *)

    "second rule succeeds" >:: (fun _ ->             (* Test second success *)
      assert_equal (Some "even")                     (* Expected result *)
        (first_of [positive; even] (-2)));            (* Actual result *)

    "no rules succeed" >:: (fun _ ->                 (* Test total failure *)
      assert_equal None                              (* Expected result *)
        (first_of [positive] 0));                    (* Actual result *)
  ]

let () = run_test_tt_main tests                      (* Run all tests *)

